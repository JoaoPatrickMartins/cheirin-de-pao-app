// Prisma v6.19.3 — MongoDB adapter
// NEVER run `prisma migrate dev` — MongoDB does not support Prisma migrations
// Only use: `prisma generate` (after schema changes) and `prisma validate` (CI)

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===== COMPOSITE TYPES (embedded documents) =====

type Address {
  street     String
  number     String
  complement String?
  city       String
  state      String
  zip        String
}

type DeliverySlot {
  slotId      String? // identificador estável interno (ex.: "manha" | "tarde") — chave de referência futura
  name        String  // legado/identidade atual; mantido igual ao slotId
  label       String? // rótulo de exibição (ex.: "Manhã") — editável
  emoji       String? // emoji de exibição (ex.: "☀️") — editável
  time        String  // "06:30" — horário de ENTREGA; personalizável por condomínio (timeCustom)
  cutoffTime  String  // "22:00" — horário de CORTE; SEMPRE global (propagado por cima)
  isActive    Boolean
  // Flags de personalização por condomínio (Etapa C). Ausente/false = herda o global e a
  // propagação sobrescreve; true = valor definido naquele condomínio e a propagação PRESERVA.
  // Só `time` e `isActive` são personalizáveis — `cutoffTime`, `label` e `emoji` seguem globais.
  timeCustom   Boolean?
  activeCustom Boolean?
}

// Item de um pedido do mercadinho — snapshot de nome e preço no momento da compra.
type MarketOrderItem {
  productId String // referência ao Product (hex ObjectId como string)
  name      String // snapshot do nome no momento da compra
  qty       Int
  unitPrice Float  // snapshot do preço unitário (R$)
}

// Item do carrinho persistente ("Cestinha") — referência viva ao produto + quantidade.
type CartItem {
  productId String
  qty       Int
}

// ===== ENUMS =====

enum UserRole {
  CLIENT
  COURIER
  ADMIN
}

enum CondoType {
  SINGLE_ENTRANCE
  BLOCKS
}

enum DiscountType {
  PERCENT
  FIXED
}

enum TransactionType {
  PURCHASE
  DELIVERY
  REFUND
  EXPIRY
  ADMIN_GRANT
  ADMIN_DEBIT
  MARKET_PURCHASE // débito ao pagar produtos do mini market com pãezinhos
  MARKET_REFUND   // crédito no cancelamento de um MarketOrder (inclui a parte paga em dinheiro)
}

enum OrderType {
  SINGLE
  SCHEDULED
}

enum OrderStatus {
  SCHEDULED
  SEPARATED
  OUT_FOR_DELIVERY
  DELIVERED
  NOT_DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  CONFIRMED
}

enum DeliveryListStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum PurchaseOrderStatus {
  DRAFT
  FINALIZED
}

// Regime de compra de um PurchaseOrder (D-9).
// DELIVERY_BATCH — produtos `stockType: DAILY` (pão, bolo): quantidade DERIVADA da demanda
//   confirmada do (dia, turno), gerada no corte. É o fluxo histórico, generalizado para N produtos.
// RESTOCK — produtos `stockType: FIXED` (geleia, café): inventário, sem demanda diária. Pedido
//   avulso, SEM turno, disparado por estoque baixo.
// Ausente/null = DELIVERY_BATCH (docs criados antes deste campo leem null no Mongo).
enum PurchaseOrderKind {
  DELIVERY_BATCH
  RESTOCK
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Finalidade de um Payment. Ausente/null = CREDITS (compra de créditos combo/avulso) —
// nullable de propósito: docs criados antes deste campo leem null no Mongo (o @default só
// vale na criação). HOOK = compra de um gancho de porta adicional (não credita pães).
// MARKET = parte em dinheiro de um pedido do mini market — NÃO credita pães; confirma o
// MarketOrder e baixa estoque (fulfill-market-order). comboId/customQuantity ficam nulos.
enum PaymentPurpose {
  CREDITS
  HOOK
  MARKET
}

// Tipo do gancho de porta concedido ao cliente (ver model HookRequest).
enum HookRequestType {
  FREE  // 1º gancho gratuito — ao comprar um combo OU pedido único >= mínimo configurado
  PAID  // gancho adicional pago (Pix) — reposição por defeito/perda
  BONUS // gancho concedido pelo admin como bonificação (sem custo)
}

// Estado do ciclo de vida de um gancho.
enum HookRequestStatus {
  PENDING_PAYMENT // PAID aguardando confirmação do pagamento (ainda não entra na fila)
  REQUESTED       // na fila — aguardando a entrega física pelo admin
  DELIVERED       // entregue ao cliente (auditável)
  CANCELLED       // pagamento falhou/expirou (PAID que nunca confirmou)
}

enum NotificationType {
  DELIVERY_EVE
  DELIVERY_DONE
  LOW_CREDIT
  CUTOFF
  RECONFIGURE
  CREDIT_PURCHASED
  CREDIT_GRANTED
  SCHEDULE_PAUSED
  HOOK_DELIVERED
  // Cliente — Cestinha ("Além do Pãozin"). A entrega reusa DELIVERY_DONE (paridade com o pão);
  // estes dois não têm equivalente no pão e por isso são tipos próprios.
  MARKET_ORDER_CANCELLED // Cestinha cancelada sem ação do cliente (sweep de pagamento / admin)
  MARKET_NOT_DELIVERED   // Cestinha não entregue (cliente ausente, endereço, etc.)
  // Admin — avisos operacionais (cada um com toggle individual em adminNotificationPrefs)
  ADMIN_ORDER_PLACED
  ADMIN_HOOK_REQUESTED
  ADMIN_DELIVERY_DONE
  ADMIN_DELIVERY_FAILED
  ADMIN_DELIVERY_PENDING
  ADMIN_ORDER_CANCELLED
  ADMIN_CREDIT_PURCHASED
  ADMIN_CUTOFF_REACHED
  ADMIN_AUTOGEN_WARNING
  ADMIN_AUTOGEN_DONE
  ADMIN_LOW_STOCK // produto do mercadinho com estoque baixo / esgotado
  // Entregador — avisos automáticos (sem toggle)
  COURIER_NEW_ORDERS
  COURIER_PENDING_REMINDER
}

enum AnalyticsEventType {
  ACCESS // abertura do app / carga da PWA por um visitante (anônimo)
  LOGIN  // verificação de OTP bem-sucedida que cria uma sessão
}

// Tipo de estoque de um Product do mini market.
enum StockType {
  DAILY // capacidade que reseta a cada dia (ex.: bolos)
  FIXED // inventário absoluto que só cai até ser reposto (ex.: geleia)
}

// Ciclo de vida de um MarketOrder. Espelha OrderStatus (mesmos valores de string, para pegar
// carona na esteira do Order) + PENDING_PAYMENT (aguardando pagamento em dinheiro, ainda fora
// da esteira). Enum próprio para NÃO tocar em OrderStatus (Order de pão permanece intocado).
enum MarketOrderStatus {
  PENDING_PAYMENT
  SCHEDULED
  SEPARATED
  OUT_FOR_DELIVERY
  DELIVERED
  NOT_DELIVERED
  CANCELLED
}

// ===== MODELS (15 collections) =====

// 1. User — clientes, entregadores e admins
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String?   @unique
  phone         String?   @unique
  role          UserRole
  name          String
  cpf           String    @unique
  birthDate     DateTime?
  // Auth por senha (bcrypt). null = ainda não definiu — força definição no 1º acesso via OTP.
  // Nunca expor este campo em respostas/selects públicos.
  passwordHash  String?
  passwordSetAt DateTime?
  isBlocked     Boolean   @default(false)
  // Contexto do bloqueio atual (auditoria) — preenchido ao bloquear, limpo ao desbloquear
  blockReason   String?
  blockedAt     DateTime?
  blockedById   String?   @db.ObjectId
  condominiumId String?   @db.ObjectId
  apartment     String?
  block         String?
  // LEGADO — nada em runtime lê nem escreve este campo desde a limpeza (31/07/2026). Continua
  // declarado só porque é a FONTE do backfill do boot. Num cliente ativo hoje o valor está
  // CONGELADO no momento da limpeza: não use para nada.
  creditBalance      Int       @default(0)
  // Saldo CANÔNICO em milésimos de pãozinho (1 pão = 1000) — **é o único saldo da aplicação**.
  // Inteiro de propósito: `Float` em dinheiro acumula drift, e trocar o tipo de um campo `Int` já
  // gravado quebra a leitura no Prisma + MongoDB. Nullable porque `@default` não cria a chave em
  // documento pré-existente; o backfill do boot garante que toda chave exista antes do tráfego.
  creditMilli        Int?
  autoRecharge       Json?
  // Preferências de notificação do ADMIN — mapa { [NotificationType]: boolean }.
  // Ausência/null = todos os tipos ligados; só grava as chaves DESLIGADAS (false).
  adminNotificationPrefs Json?
  cardTokenMp        String?
  oneSignalPlayerId  String?
  mpCustomerId       String?
  stripeCustomerId   String?
  // Consentimento explícito para cobranças sem CVV (off_session / card-on-file)
  offSessionConsentAt DateTime?
  // LEGADO — gancho de porta. Migrado para a coleção HookRequest (um doc por gancho).
  // Mantidos apenas para o backfill (scripts/backfill-hook-requests.ts) ler o estado antigo.
  // NÃO escrever mais aqui: a fonte da verdade agora é HookRequest. Podem ser removidos
  // após o backfill rodar em produção.
  hookRequestedAt    DateTime?
  hookDeliveredAt    DateTime?
  hookDeliveredById  String?   @db.ObjectId
  // Tutorial de primeiro acesso — momento em que o cliente concluiu/pulou o onboarding.
  // FONTE DE VERDADE de "já viu o tutorial": null/ausente = ainda não concluiu (mostra
  // automaticamente no 1º acesso). Lido em GET /client/onboarding, gravado uma única
  // vez em POST /client/onboarding/complete.
  onboardingCompletedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 2. Condominium — condomínios cadastrados
model Condominium {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  address       Address
  // Coordenadas usadas pela rota do entregador (OSRM). Definidas manualmente pelo admin
  // ou geocodificadas (Nominatim) ao criar/editar. Nulas enquanto não localizado.
  lat           Float?
  lng           Float?
  // true quando a geocodificação só resolveu a nível de cidade (centro) — impreciso.
  approxLocation Boolean @default(false)
  type          CondoType
  // Número de blocos/torres — usado apenas quando type == BLOCKS. Nulo em SINGLE_ENTRANCE.
  numBlocks     Int?
  isActive      Boolean   @default(true)
  deliverySlots DeliverySlot[]
  // Overrides das restrições por dia da semana (Etapa C). AUSENTE = herda o padrão global
  // (Setting `diasBloqueados` / `limitePedidosDia`). Presente = mapa completo `{seg..dom}` que
  // substitui o global naquele condomínio.
  //
  // ATENÇÃO (Mongo): a resolução é feita EM CÓDIGO (`override ?? global`) — nunca consultar
  // `where: { blockedDaysOverride: null }`, que não encontra documento sem a chave.
  blockedDaysOverride Json?
  dayLimitOverride    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 3. Combo — pacotes de créditos de pãezinhos
model Combo {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  quantity       Int
  price          Float
  tag            String?
  // Subtítulo curto exibido no card (ex.: "O equilíbrio da casa")
  description    String?
  // Liga/desliga a tag de economia no card. A economia é calculada automaticamente
  // comparando o preço do combo com comprar a mesma quantidade no avulso (avulsoUnit).
  // Nullable de propósito: combos criados antes deste campo leem null no Mongo (o
  // @default só vale na criação) — o código trata null/ausente como "ligada".
  showEconomy    Boolean? @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 4. Promotion — promoções e descontos temporários por combo
model Promotion {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  comboId       String       @db.ObjectId
  discountType  DiscountType
  discountValue Float
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// 5. Setting — configurações globais (horário de corte, preço avulso, etc.)
model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 6. CreditTransaction — movimentação de créditos (imutável — sem updatedAt)
model CreditTransaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  userId      String          @db.ObjectId
  type        TransactionType
  // LEGADO — nada em runtime lê nem escreve este campo desde a limpeza (31/07/2026). Continua
  // declarado só porque é a FONTE do backfill do boot (`credit-milli-backfill.ts`), que preenche
  // `quantityMilli` em linhas antigas. Opcional porque linhas novas não o gravam.
  quantity    Int?
  // Movimento CANÔNICO em milésimos de pãozinho (negativo = débito). É o único que a aplicação lê.
  quantityMilli Int?
  referenceId String?
  description String?
  adminId     String?         @db.ObjectId
  reason      String?
  createdAt   DateTime        @default(now())
}

// 7. Schedule — agendamento semanal personalizado por cliente
model Schedule {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  condominiumId     String   @db.ObjectId
  weeklyQty         Json?
  deliveryTime      String?
  notifyReconfigure Boolean  @default(false)
  isActive          Boolean  @default(true)
  // Pausa da agenda pelo próprio cliente. null = não pausada; preenchido = pausada desde então.
  // Gate no corte é feito em código (if schedule.pausedAt) — evita null-vs-unset do Mongo.
  pausedAt          DateTime?
  // Último lembrete "pausada há muito tempo" enviado — controla a cadência semanal.
  lastPauseReminderAt DateTime?
  days              Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, condominiumId])
}

// 8. Order — pedidos unitários (avulsos ou gerados pelo schedule)
model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userId         String      @db.ObjectId
  type           OrderType
  quantity       Int
  scheduledDate  DateTime
  status         OrderStatus
  deliveryListId String?     @db.ObjectId
  courierId      String?     @db.ObjectId
  condominiumId  String?     @db.ObjectId
  slotId         String?     // identificador estável do slot (chave de junção; Etapa B)
  deliveryTime   String?     // snapshot do horário de entrega no momento do pedido (exibição)
  paymentId      String?     @db.ObjectId // vínculo leve ao Payment que financiou o avulso (só quando houve pagamento; nulo quando pago via saldo). Base do estorno de dinheiro a partir de um pedido parado.
  // Marcos do ciclo de vida (rastreabilidade ponta-a-ponta — evita pedido "no limbo")
  separatedAt    DateTime?   // quando foi separado/conferido (entra na divisão de entregas)
  deliveredAt    DateTime?   // quando foi confirmado como entregue
  failedAt       DateTime?   // quando foi marcado como NÃO entregue
  failureReason  String?     // motivo da não-entrega (cliente ausente, endereço, etc.)
  cancelledAt    DateTime?   // quando foi cancelado
  cancelReason   String?     // motivo do cancelamento
  deliveryNote   String?     // nota da entrega manual/retroativa (resolução de pedido parado marcado como entregue)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, scheduledDate])
  @@index([condominiumId, scheduledDate])
}

// 9. Delivery — registro de entrega com confirmação por entregador
model Delivery {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String         @db.ObjectId
  courierId   String         @db.ObjectId
  deliveredAt DateTime?
  confirmedAt DateTime?
  status      DeliveryStatus
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// 10. DeliveryList — lista consolidada por condomínio para entregadores
model DeliveryList {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  condominiumId String             @db.ObjectId
  courierId     String?            @db.ObjectId
  status        DeliveryListStatus
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// 11. Supplier — fornecedores
model Supplier {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  cnpj         String   @unique
  phone        String?
  email        String?
  address      Address
  // LEGADO (D-10) — preço unitário DO PÃO. Substituído pela matriz `SupplierProduct`, que guarda
  // um custo por (fornecedor, produto). NÃO removido: há dados em produção e ele serve de fallback
  // de leitura até o backfill rodar. Não escrever mais aqui como fonte de verdade de preço.
  pricePerUnit Float
  isActive     Boolean  @default(true)
  // LEGADO (D-10) — "principal global". Virou a semente do `isPreferred` do pão na matriz.
  isPrincipal  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 26. SupplierProduct — catálogo de fornecimento: quem fornece o quê, por quanto (D-7/D-8).
//
// A EXISTÊNCIA da linha É a afirmação "este fornecedor fornece este produto". Sem linha não há
// custo cadastrável e o fornecedor nem aparece como opção para aquele produto. Antes disto o
// modelo só sabia comprar UM produto: `Supplier.pricePerUnit` era um preço só (o do pão) e
// `PurchaseOrderItem` não tinha `productId`.
model SupplierProduct {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  supplierId      String   @db.ObjectId
  productId       String   @db.ObjectId
  unitCost        Float    // custo unitário DESTE produto NESTE fornecedor (R$)
  // Fatia padrão da demanda deste produto neste fornecedor (0..100). A soma por produto deve ser
  // 0 (sem rateio definido → 100% no `isPreferred`) ou 100. Cobre "tudo no X" (100/0) e
  // "parte no X, parte no Y" (75/25) — preservando o split 75/25 histórico do pão.
  defaultSharePct Int      @default(0)
  // Fornecedor padrão do produto: desempata o arredondamento do rateio e recebe o resto.
  isPreferred     Boolean  @default(false)
  minOrderQty     Int?     // pedido mínimo do fornecedor para este produto (aviso, não bloqueio)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([productId, isActive])
}

// 12. PurchaseOrder — pedidos de compra ao fornecedor (cabeçalho)
// DELIVERY_BATCH: um pedido por TURNO (slot) — cada (date, slotId) gera o seu.
// RESTOCK: pedido avulso de reposição de inventário — `slotId` fica nulo (D-9).
model PurchaseOrder {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  slotId        String?             // turno do pedido (manha/tarde) — nulo em RESTOCK
  slotLabel     String?             // rótulo de exibição do turno (ex.: "Manhã")
  // ATENÇÃO: `totalQuantity` continua significando **só PÃES**. `getWasteReport` compara este
  // campo com os pães entregues; se ele passasse a somar bolos e geleias, o desperdício explodiria.
  // Os totais dos outros produtos vivem em `totalItems`/`totalValue`.
  totalQuantity Int
  totalItems    Int?                // unidades de produtos NÃO-pão neste pedido
  totalValue    Float?              // custo total do pedido (R$)
  kind          PurchaseOrderKind?  // null/ausente = DELIVERY_BATCH (compat com docs antigos)
  cutoffTime    DateTime
  status        PurchaseOrderStatus
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// 13. PurchaseOrderItem — uma linha por (produto, fornecedor) do pedido
model PurchaseOrderItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String   @db.ObjectId
  supplierId      String   @db.ObjectId
  // null/ausente = pão (itens criados antes da matriz de fornecimento). Novos itens sempre gravam.
  productId       String?  @db.ObjectId
  productName     String?  // snapshot do nome no momento da compra
  quantity        Int
  unitPrice       Float    // snapshot de SupplierProduct.unitCost
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 14. Payment — pagamentos via Mercado Pago (Pix/cartão)
model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  amount        Float
  method        PaymentMethod
  status        PaymentStatus
  // Legados/Stripe: SEM @unique — índice único do Mongo rejeita múltiplos nulls
  // (todo pagamento Stripe tem mercadoPagoId null; pagamentos MP antigos têm
  // stripePaymentIntentId ausente). Idempotência é garantida na aplicação.
  mercadoPagoId  String?
  stripePaymentIntentId String?
  comboId        String?       @db.ObjectId
  customQuantity Int?
  // Finalidade do pagamento. Ausente/null = CREDITS (compra de créditos). HOOK = gancho
  // adicional pago — o fulfillment (credit-payment.ts) NÃO credita pães; marca o HookRequest.
  purpose        PaymentPurpose?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// 20. HookRequest — cada gancho de porta que um cliente obtém ao longo do tempo.
// Substitui os campos hook* do User (single-slot) por histórico: 1 grátis + N pagos/bônus.
// Regra do grátis "uma vez só": cliente elegível ⇔ NÃO possui nenhum HookRequest.
model HookRequest {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  userId        String            @db.ObjectId
  type          HookRequestType
  status        HookRequestStatus
  reason        String?           // motivo (defeito/perda no PAID; texto da bonificação no BONUS)
  paymentId     String?           @db.ObjectId // vínculo ao Payment (apenas PAID)
  grantedById   String?           @db.ObjectId // admin que concedeu (apenas BONUS)
  requestedAt   DateTime?         // quando entrou na fila de entrega (status REQUESTED)
  deliveredAt   DateTime?         // quando o admin registrou a entrega
  deliveredById String?           @db.ObjectId // admin que entregou (auditoria)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, requestedAt])
}

// 15. Notification — fila de notificações por tipo (imutável — sem updatedAt)
model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false)
  actionRoute String?
  createdAt   DateTime         @default(now())
}

// 16. Session — persistent device sessions
model Session {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  token      String   @unique
  deviceId   String
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// AdminNote — notas internas do admin sobre um cliente (suporte/CRM)
model AdminNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  adminId   String   @db.ObjectId
  body      String
  createdAt DateTime @default(now())
}

// 17. OtpCode — one-time codes for login and registration
model OtpCode {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  code      String
  channel   String
  expiresAt DateTime
  usedAt    DateTime?
  purpose   String?
  createdAt DateTime  @default(now())
}

// 18. SavedCard — cartões salvos do cliente (Stripe PaymentMethod; mpCardId legado)
model SavedCard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  mpCardId  String?
  stripePaymentMethodId String?
  brand     String
  lastFour  String
  expiresAt String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// MaterializedCycle — marca persistida de que o ciclo de corte de um (condomínio, slot, dia de
// entrega) já foi materializado. Substitui o Set em memória: permite o backfill recuperar cortes
// perdidos mesmo cruzando a meia-noite e sobreviver a restart do servidor. `deliveryDate` é a data
// BRT da entrega no formato YYYY-MM-DD (absoluta), não HH:MM.
model MaterializedCycle {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  condominiumId String   @db.ObjectId
  slotId        String
  deliveryDate  String
  createdAt     DateTime @default(now())

  @@unique([condominiumId, slotId, deliveryDate])
}

// 19. AnalyticsEvent — eventos de acesso e login para os Relatórios (imutável — sem updatedAt)
// Stream único que permite calcular a conversão acesso→login pelo mesmo `visitorId`.
// `visitorId` é o device_id anônimo gerado no cliente (sem PII).
model AnalyticsEvent {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  type      AnalyticsEventType
  visitorId String             // ID anônimo do dispositivo (device_id do cliente)
  userId    String?            @db.ObjectId // preenchido apenas em LOGIN
  role      String?            // CLIENT | COURIER | ADMIN (em LOGIN)
  path      String?            // rota/tela inicial no momento do evento
  referrer  String?
  platform  String?            // 'pwa' | 'browser'
  userAgent String?            // para breakdown de SO/dispositivo
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
}

// ===== MINI MARKET "Além do Pãozin" (feature nova) =====

// 21. ProductCategory — categorias do mini market (6 padrão semeadas + criadas pelo admin)
model ProductCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  emoji     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 22. Product — produtos do mini market (café da manhã além do pão francês)
model Product {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  categoryId    String    @db.ObjectId
  price         Float     // preço em R$
  photoUrl      String?   // URL no S3; ausente → ícone/cor da categoria no front
  stockType     StockType
  stock         Int?      // FIXED: inventário atual (null quando DAILY)
  dailyCapacity Int?      // DAILY: capacidade por dia (null quando FIXED)
  availableDays Json?     // null/ausente = sempre; senão lista de dias ["seg","qua",...]
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId, isActive])
}

// 23. Cart — carrinho ("Cestinha") persistente por cliente (1 por usuário)
model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  items     CartItem[]
  breadQty  Int        @default(0) // pães adicionados via add-on do pedido de pão (C8)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// 24. MarketOrder — pedido do mini market. Pega carona na esteira do Order (mesma tripla
// condominiumId+scheduledDate+slotId) SEM refatorar o Order. breadQty = pães da cestinha.
model MarketOrder {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  userId         String            @db.ObjectId
  condominiumId  String            @db.ObjectId
  scheduledDate  DateTime          // meio-dia BRT do dia de entrega (mesma convenção do Order)
  slotId         String
  deliveryTime   String?           // snapshot do horário (exibição)
  status         MarketOrderStatus
  courierId      String?           @db.ObjectId
  breadQty       Int               @default(0) // pães da cestinha — somam no total de pães da parada
  items          MarketOrderItem[]
  totalValue     Float             // R$ total (produtos + breadQty*avulsoUnit)
  // LEGADO — não lido nem escrito em runtime; só fonte do backfill do boot. Pedido novo fica 0.
  creditsApplied Int               @default(0)
  // Pãezinhos aplicados em milésimos (CANÔNICO) — o único lido pela aplicação. É o que permite
  // pagar 100% com pãezinhos um item de R$ 1,80 (1,5 🥖). Nullable: ver `creditMilli`.
  creditsAppliedMilli Int?
  moneyAmount    Float             @default(0) // R$ cobrado no gateway (0 = 100% crédito)
  paymentId      String?           @db.ObjectId
  idempotencyKey String            @unique     // trava anti-duplo-clique do checkout
  separatedAt    DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  cancelledAt    DateTime?
  cancelReason   String?
  // Desfecho FÍSICO de uma Cestinha NOT_DELIVERED (Onda G2). O status terminal diz que a entrega
  // falhou; estes campos dizem o que aconteceu com a mercadoria e com o crédito — coisas que só
  // quem recebeu o entregador de volta sabe. `lossResolvedAt: null` numa NOT_DELIVERED = PENDENTE,
  // e é isso que a torna visível no admin em vez de virar prejuízo silencioso.
  lossResolvedAt DateTime?
  lossResolvedBy String?           @db.ObjectId // admin que deu o desfecho (auditoria)
  stockReturned  Boolean?          // true = itens voltaram à prateleira; false = perda real
  lossReason     String?           // o que aconteceu (perdido, avariado, devolvido…)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([condominiumId, scheduledDate])
  @@index([courierId, scheduledDate])
  @@index([userId, createdAt])
}

// 25. ProductDailyStock — contador atômico de reservas por (produto, dia) p/ estoque DAILY.
// disponível = Product.dailyCapacity − reserved. Dia novo = doc novo (chave por data BRT).
model ProductDailyStock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  date      String   // dia de entrega BRT no formato YYYY-MM-DD
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
}

// 26. DeliveryBlock — bloqueio de uma DATA ou de um PERÍODO para pedidos/entregas.
//
// Complementa o bloqueio por dia da semana (`diasBloqueados`), que é recorrente: aqui o admin
// bloqueia datas pontuais (feriado, férias da padaria) ou uma faixa contínua (obra na portaria).
//
// Escopo: `condominiumId` AUSENTE = bloqueio GLOBAL (vale para todos os condomínios); presente =
// vale só naquele condomínio. Uma data está bloqueada se cair em QUALQUER um dos dois.
//
// Datas em String "YYYY-MM-DD" (dia BRT), mesma convenção de `ProductDailyStock.date` — evita
// toda a ambiguidade de fuso de um DateTime (o dia BRT não coincide com o dia UTC).
// Data única = `startDate == endDate`. Intervalo INCLUSIVO nas duas pontas.
//
// Vale para os três caminhos de entrega: pedido único (avulso), agenda (o corte não gera) e
// Cestinha. Não tem granularidade por turno — bloquear uma data bloqueia todos os turnos.
model DeliveryBlock {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  condominiumId String?  @db.ObjectId
  startDate     String
  endDate       String
  reason        String?  // motivo exibido ao cliente (ex.: "Feriado", "Portaria em obra")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([condominiumId, startDate])
  @@index([startDate, endDate])
}
